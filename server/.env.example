# Server port (backend + admin dashboard)
PORT=4000

# Local MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/smugsafaris

# JWT signing (change this in production)
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Admin dashboard login
ADMIN_EMAIL=admin@smugsafaris.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Smugs Safari Admin

# Allowed CORS origins (frontend dev server)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
